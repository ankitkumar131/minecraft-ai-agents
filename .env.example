MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=BuilderBot
# Set microsoft for online-mode servers; omit for offline-mode private servers.
MC_AUTH=offline
# Optional: pin this to your server version, e.g. 1.20.4
MC_VERSION=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Required if binding HTTP_HOST to a non-loopback interface
API_TOKEN=
PROFILES_FILE=data/profiles.json
# Optional ordered provider list (JSON). Keys are read from server environment variables,
# never from profiles or browser requests. See docs/blueprint.md.
# AI_PROVIDERS=[{"name":"primary","type":"openai-compatible","url":"https://your-provider.example/v1/","model":"your-model","keyEnv":"PRIMARY_AI_KEY"},{"name":"local","type":"ollama","url":"http://127.0.0.1:11434","model":"qwen2.5:7b"}]
MEMORY_DIR=data/memory
# Minecraft in-game chat commands are disabled unless the player is listed here.
MC_ALLOWED_PLAYERS=
